{
  "manifest_version": 3,
  "name": "Auto-Cyborg 360 — Publicador Automotriz",
  "version": "1.0.0",
  "description": "Automatización y puente DOM para publicación de vehículos en Facebook Marketplace, Instagram y WhatsApp desde AutoApp.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto-Cyborg 360"
  },
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://www.facebook.com/*",
    "*://web.whatsapp.com/*",
    "*://www.instagram.com/*",
    "http://localhost:3000/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.facebook.com/marketplace/create/vehicle*",
        "*://www.facebook.com/marketplace/create/*",
        "*://web.whatsapp.com/*",
        "*://www.instagram.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
